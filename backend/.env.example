CORS_ORIGINS=http://localhost:5173
VESPER_DOMAIN=vesper-scar.duckdns.org
CERTBOT_EMAIL=YOUR_EMAIL
SIBYL_OFFICIAL=1
SIBYL_DB_PATH=/app/data/trading.db
TRADING_MODE=paper
# GROQ_API_KEY=
# GEMINI_API_KEY=
# POLYMARKET_PRIVATE_KEY= # never use in paper mode
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
# LIVE_TRADING_ENABLED=false
PIPELINE_INTERVAL_SECONDS=60
INGEST_MARKET_LIMIT=50
MIN_MARKET_SNAPSHOTS=1000
MIN_DATA_QUALITY=0.95
MARKET_DATA_RETRIES=3
MAX_BOOK_LEVELS=50
INGEST_REQUIRE_BOOKS=true
# Required before /operator/request-live can record approval. Keep secret.
# OPERATOR_APPROVAL_CODE=replace-with-a-long-random-value
VESPER_AUTH_REQUIRED=true
# Required in non-test deployments. Use separate long random values.
# VESPER_API_KEY=replace-with-a-long-random-api-key
# VESPER_ADMIN_KEY=replace-with-a-long-random-admin-key
# Generate with: openssl rand -hex 32
# VESPER_SESSION_SECRET=replace-with-a-long-random-session-signing-secret
# Session lifetime in seconds (8 hours by default)
# VESPER_SESSION_TTL_SECONDS=28800
# For Cloudflare Pages -> EC2 cross-origin cookies use None/true behind HTTPS.
# VESPER_COOKIE_SAMESITE=None
# VESPER_COOKIE_SECURE=true
# VESPER_READ_KEY=optional-read-only-key
VESPER_RATE_LIMIT_PER_MINUTE=120
