# Remote S3 destination for the scheduled backup container.
# Create a private bucket and use a dedicated least-privilege IAM identity.
BACKUP_S3_URI=s3://replace-with-your-private-bucket/vesper
AWS_REGION=eu-west-3
BACKUP_INTERVAL_SECONDS=900
BACKUP_LOCAL_RETENTION_DAYS=2

# Prefer an EC2 instance role where the container can access it. Otherwise put
# the dedicated upload identity credentials here and chmod 600 this file.
# AWS_ACCESS_KEY_ID=replace-with-upload-only-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-upload-only-secret
